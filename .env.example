# Токен бота от @BotFather
BOT_TOKEN=

# Строка подключения к Neon (Postgres), лучше pooled (-pooler) версию
DATABASE_URL=

# Любая случайная строка — секрет для проверки вебхука Telegram
WEBHOOK_SECRET=change-me-in-render-env

# Ставится автоматически на Render — используется, чтобы понять,
# что бот работает в облаке (и поднять webhook, а не polling)
# RENDER_EXTERNAL_URL=

# Публичный URL этого же сервиса + /app — адрес Mini App.
# После деплоя на Render впишите сюда, например:
# MINI_APP_URL=https://your-service.onrender.com/app
MINI_APP_URL=

# Необязательные настройки пула соединений к базе
DB_POOL_SIZE=15
DB_POOL_MIN=3

# Необязательні ліміти ставок в Mini App
MINI_APP_MIN_BET=10
MINI_APP_MAX_BET=50000

# Username бота без @ — потрібен для кнопки "Увійти" на сайті (посилання
# https://t.me/<BOT_USERNAME>?start=weblogin_...). Якщо не задати, бот сам
# підставить свій username при першому запиті — можна лишити порожнім.
BOT_USERNAME=NeonCasinoXBot
